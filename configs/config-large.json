    },
    "oidc": {
      "provider": "http://localhost:8080/realms/clustercockpit",
      "client-id": "cc-backend",
      "client-secret": "cc-backend-dev-secret",
      "sync-user-on-login": true,
      "update-user-on-login": true,
      "role-mapping": {
        "cc-admin": "admin"
      }
